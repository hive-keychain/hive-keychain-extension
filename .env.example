# Copy to .env — optional; defaults are baked into the app when unset.
# Values listed here are compiled into extension bundles at build time (see webpack/env.js).

# --- Dev / debugging ---
# DEBUG_LOG=true
# STOP_AUTOLOCK=true
# FORCED_EVM_WALLET_ADDRESS=
# PORTFOLIO_SKIP_BALANCE_CHECK=true
# PORTFOLIO_DEV_GEO_COUNTRY=RU

# --- Backend overrides (production URLs used when unset) ---
# KEYCHAIN_API_URL=https://api.hive-keychain.com
# EVM_LIGHT_NODE_API_URL=https://evm.hive-keychain.com
# EVM_LIGHT_NODE_API_URL=http://localhost:3000
# PORTFOLIO_API_URL=http://localhost:4000
HIVE_PROMOTION_MIN_INSTALL_AGE_DAYS=7
# STOP_AUTOTASKS=true
# MULTISIG_BACKEND_SERVER=https://api-multisig.hive-keychain.com
# KEYLESS_HOST=https://hive-auth.arcange.eu/
# KEYCHAIN_SWAP_API_DEV=true

# --- Timers & tuning (dev) ---
# DEV_CLAIM_FREQUENCY=5
# DEV_CLAIM_ACCOUNT_RC_PCT=70
# DEV_CLAIM_ACCOUNT_MIN_RC=12000000000000
# DEV_CLAIM_SAVINGS_DELAY=30
# DEV_SWAP_AUTO_REFRESH=30
# DEV_TUTORIAL=https://tutorial.hive-keychain.com
# DUPLICATE_REQUEST_EXPIRATION_TIME_IN_MINUTES=60
# EVM_DATA_EXPIRATION_TIME=86400000

# --- Jest integration tests (optional) ---
# _TEST_USERNAME=
# _TEST_MASTER=
# _TEST_OWNER=
# _TEST_OWNER_PUB=
# _TEST_ACTIVE=
# _TEST_ACTIVE_PUB=
# _TEST_POSTING=
# _TEST_POSTING_PUB=
# _TEST_MEMO=
# _TEST_MEMO_PUB=
# _TEST_USER_PWD=
# _TEST_USER_ENCRYPTED_ACCOUNTS=
